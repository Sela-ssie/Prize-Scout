# YouTube Data API v3 key. Required only for ingestion/corpus collection.
# Search and the web UI read the local index without contacting YouTube.
# Create at https://console.cloud.google.com/apis/credentials with the
# "YouTube Data API v3" enabled. Check the project's actual Cloud Console quotas;
# production ingestion uses 1-unit channel, upload-playlist, and video detail calls.
YOUTUBE_API_KEY=

# SQLAlchemy database URL. Defaults to sqlite:///./prizes.db when unset.
DATABASE_URL=sqlite:///./prizes.db

# Optional single-process hosted ingestion. Keep 0 when using scripts/ingest.py.
INGESTION_ENABLED=0
WATCHLIST_PATH=config/watchlist.json
INGESTION_INTERVAL=3600
INGESTION_MAX_UNITS=100
INGESTION_DAILY_MAX_UNITS=1000
INGESTION_MAX_PAGES=1
INGESTION_TIMEOUT=120
# scripts/serve.py honors PORT (default 8000) and HOST (default 127.0.0.1).

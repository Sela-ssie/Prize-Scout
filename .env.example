# YouTube Data API v3 key. Required for /api/search and scripts/collect_corpus.py.
# Create at https://console.cloud.google.com/apis/credentials with the
# "YouTube Data API v3" enabled. Quota is 10,000 units/day (search.list = 100 units).
YOUTUBE_API_KEY=

# SQLAlchemy database URL. Defaults to sqlite:///./prizes.db when unset.
DATABASE_URL=sqlite:///./prizes.db
